
# ===== Seguranca =====
# Gere um valor forte, exemplo: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-para-uma-chave-secreta-forte
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ===== Banco de dados =====
# Use o MySQL definindo DB_ENGINE=mysql e preenchendo os dados abaixo.
# Se DB_ENGINE estiver vazio ou for sqlite, o sistema usa SQLite (db.sqlite3) local.
DB_ENGINE=sqlite
DB_NAME=financas
DB_USER=sua_usuario
DB_PASSWORD=sua_senha
DB_HOST=127.0.0.1
DB_PORT=3306

# ===== Celery / fila de tarefas =====
# Em producao use um broker real (redis://localhost:6379/0 ou amqp://localhost//).
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=django-db
# ===== Assistente de IA (API Maritaca, OpenAI-compativel) =====
# Sem a chave, o assistente fica desabilitado no sistema.
MARITACA_API_KEY=
MARITACA_BASE_URL=https://chat.maritaca.ai/api
MARITACA_MODEL=sabia-4
MARITACA_MAX_TOKENS=2048
MARITACA_TIMEOUT=60
